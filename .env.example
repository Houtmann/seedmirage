# Copy to .env to change a setting (this file is only read by docker compose).
# Every line is optional; the values below are the defaults.

# SEEDMIRAGE_IMAGE=seedmirage:local
# SEEDMIRAGE_VERSION=dev

# Host UID/GID that own ./data (`id -u`, `id -g`).
# SEEDMIRAGE_UID=1000
# SEEDMIRAGE_GID=1000

# Fixed access token (at least 32 characters: openssl rand -hex 32). Empty: generated in data/ui-token.
# SEEDMIRAGE_UI_TOKEN=

# TZ=Etc/UTC
# SEEDMIRAGE_LOG_FORMAT=json
