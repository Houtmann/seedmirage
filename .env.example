# Copier en .env pour changer un réglage (ce fichier n'est lu que par docker compose).
# Toutes les lignes sont facultatives ; les valeurs ci-dessous sont les défauts.

# SEEDMIRAGE_IMAGE=seedmirage:local
# SEEDMIRAGE_VERSION=dev

# UID/GID de l'hôte propriétaires de ./data (`id -u`, `id -g`).
# SEEDMIRAGE_UID=1000
# SEEDMIRAGE_GID=1000

# Token d'accès fixe (au moins 32 caractères : openssl rand -hex 32). Vide : généré dans data/ui-token.
# SEEDMIRAGE_UI_TOKEN=

# TZ=Etc/UTC
# SEEDMIRAGE_LOG_FORMAT=json
